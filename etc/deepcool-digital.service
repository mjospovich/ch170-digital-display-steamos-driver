[Unit]
Description=DeepCool CH170 DIGITAL status display
After=systemd-udevd.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=@ROOT@
Environment=PYTHONPATH=@ROOT@
ExecStart=/usr/bin/python3 -m deepcool_ch170
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
